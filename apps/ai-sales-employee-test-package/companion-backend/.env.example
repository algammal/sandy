# Copy to .env and fill in. Never commit .env. All values below are placeholders.

# --- Server ---
PORT=8080
# Long random string. Required in the Authorization: Bearer header for every /api route.
ADMIN_API_TOKEN=replace-with-a-long-random-token
# Directory for the JSON data store (leads, calls, suppression list, event outbox).
DATA_DIR=./data
# Delete call summaries and outbox payloads older than this many days (0 = keep).
DATA_RETENTION_DAYS=365

# --- ElevenLabs ---
ELEVENLABS_API_KEY=replace-with-elevenlabs-api-key
ELEVENLABS_AGENT_ID=YOUR_TEST_AGENT_ID
# Phone number ID shown in ElevenLabs > Phone Numbers after importing a Twilio or SIP number.
ELEVENLABS_PHONE_NUMBER_ID=replace-with-phone-number-id
# twilio | sip_trunk  (must match how the number was imported)
ELEVENLABS_TELEPHONY_PROVIDER=twilio
# HMAC secret shown when you create the post-call webhook in ElevenLabs workspace settings.
ELEVENLABS_WEBHOOK_SECRET=replace-with-webhook-signing-secret
# Controller mode only: shared secret the sales_flow_step tool sends in x-sales-flow-secret.
# Store the same value as a secret in ElevenLabs. Leave empty to disable POST /tools/sales-flow.
SALES_FLOW_TOOL_SECRET=

# --- Calling safety switches ---
# disabled: no calls are ever placed (default)
# test:     calls only to numbers in TEST_ALLOWLIST
# live:     calls to eligible leads in an approved campaign
CALL_MODE=disabled
# Comma-separated E.164 numbers you are authorised to call during testing.
TEST_ALLOWLIST=+15550000001
# true = run every check and return what would be sent, but never contact ElevenLabs.
DRY_RUN=true

# --- Our company (the seller of the AI Sales Employee) passed to the agent on every call ---
COMPANY_NAME=replace-with-your-company-name
# Persona name the AI uses when introducing itself (it always says it is an AI).
AGENT_PERSONA_NAME=سارة
